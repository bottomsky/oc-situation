{
  "name": "ais-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node --import tsx scripts/workspace.ts lint",
    "format:check": "prettier --check apps packages scripts tests infra docs .github README.md package.json tsconfig.json tsconfig.base.json eslint.config.mjs vitest.config.ts playwright.config.ts .prettierrc.json",
    "format": "prettier --write apps packages scripts tests infra docs .github README.md package.json tsconfig.json tsconfig.base.json eslint.config.mjs vitest.config.ts playwright.config.ts .prettierrc.json",
    "typecheck": "node --import tsx scripts/workspace.ts typecheck",
    "test": "node --import tsx scripts/workspace.ts test",
    "test:integration": "node --import tsx scripts/workspace.ts test:integration",
    "test:integration:isolated": "node --import tsx scripts/isolated.ts test:integration",
    "test:e2e:isolated": "node --import tsx scripts/isolated.ts test:e2e",
    "test:e2e": "node --import tsx scripts/workspace.ts test:e2e",
    "build": "node --import tsx scripts/workspace.ts build",
    "dev:api": "node --import tsx scripts/workspace.ts dev @ais/api",
    "dev:web": "node --import tsx scripts/workspace.ts dev @ais/web",
    "dev:intelligence": "node --import tsx scripts/workspace.ts dev @ais/intelligence",
    "intelligence:sources": "node --import tsx scripts/workspace.ts intelligence:sources",
    "dev:topics": "node --import tsx scripts/workspace.ts dev @ais/topics",
    "dev:agent": "node --import tsx scripts/workspace.ts dev @ais/agent",
    "agent:smoke": "node --import tsx apps/agent/smoke.ts",
    "agent:skills:check": "node apps/agent/dist/check-skills.mjs",
    "heatmap:smoke": "node --import tsx scripts/heatmap-build-smoke.ts",
    "infra:up": "node --import tsx scripts/workspace.ts infra:up",
    "migrate": "node --import tsx scripts/workspace.ts migrate",
    "seed": "node --import tsx scripts/workspace.ts seed",
    "demo": "node --import tsx scripts/workspace.ts demo",
    "bench": "node --import tsx scripts/workspace.ts bench",
    "api:generate": "node --import tsx scripts/workspace.ts api:generate",
    "build:smoke": "node --import tsx scripts/workspace.ts build:smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@clickhouse/client": "1.23.1",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "argon2": "0.45.1",
    "cheerio": "1.2.0",
    "crawlee": "3.18.2",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "esbuild": "0.28.2"
  },
  "trustedDependencies": [
    "argon2",
    "esbuild",
    "@nestjs/core"
  ]
}

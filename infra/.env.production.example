# Only synthetic placeholders. Copy outside the repository and set real values.
AIS_IMAGE=registry.example.invalid/ais-platform:2026.10.17
PUBLIC_DOMAIN=ais.example.invalid
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql://ais:replace-with-postgres-password@postgres:5432/ais
CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
NATS_AUTH_TOKEN=replace-with-nats-token
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=us-east-1
S3_BUCKET=ais-production-dedicated
S3_ACCESS_KEY_ID=replace-with-runtime-access-key
S3_SECRET_ACCESS_KEY=replace-with-runtime-secret
S3_INIT_ACCESS_KEY_ID=replace-with-bootstrap-access-key
S3_INIT_SECRET_ACCESS_KEY=replace-with-bootstrap-secret
ADMIN_USERNAME=replace-with-admin-name
ADMIN_PASSWORD=replace-with-at-least-12-characters
AGENT_ENABLED=false
AGENT_UI_ENABLED=false
# 私有技能自主创建、发布与动态执行；API 和 Agent 必须同步配置。
AGENT_DYNAMIC_SKILLS_ENABLED=false
AGENT_SPATIAL_FOCUS_ENABLED=false
AGENT_BUSINESS_WRITE_ENABLED=false
ROUTE_PLANNING_ENABLED=false
EVENT_SYNC_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 模型思考默认 high；设为 off 关闭。
AGENT_THINKING_LEVEL=high
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_RECORDS=50000
AIS_ALLOW_LIVE=false
AISSTREAM_API_KEY=
MARINETRAFFIC_API_KEY=
CRAWL_RUN_TIMEOUT_SECONDS=900
GRAFANA_PASSWORD=replace-with-grafana-password
AIS_BACKEND_SUBNET=172.29.40.0/24
CADDY_BACKEND_IP=172.29.40.10

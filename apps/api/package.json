{
  "name": "@ais/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "build": "node --import tsx ../../scripts/build.ts --workspace api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts ../../apps/api",
    "test:integration": "vitest run --config ../../vitest.config.ts ../../apps/api"
  },
  "dependencies": {
    "@ais/contracts": "workspace:*",
    "@ais/domain": "workspace:*",
    "@ais/infrastructure": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "argon2": "0.45.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  }
}

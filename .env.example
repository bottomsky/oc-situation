# 开发默认值；Node 服务通过部署环境或明确的 --env-file 参数读取配置。
NODE_ENV=development
API_PORT=13000
API_HOST=127.0.0.1
WEB_ORIGINS=http://127.0.0.1:13001,http://localhost:13001
# 生产仅信任 Caddy 的精确内部 IP；开发始终忽略 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=
CRAWL_RUN_TIMEOUT_SECONDS=900
METRICS_HOST=127.0.0.1
METRICS_PORT=13100
DATABASE_URL=postgresql://ais:ais-local-only@127.0.0.1:15432/ais
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_DATABASE=ais
CLICKHOUSE_USER=ais
CLICKHOUSE_PASSWORD=ais-local-only
NATS_URL=nats://127.0.0.1:14222
NATS_TOKEN=
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=ais-raw
S3_ACCESS_KEY_ID=ais-local
S3_SECRET_ACCESS_KEY=ais-local-only-secret
# seed 需要显式管理员配置；demo 自动创建仅用于本机的随机凭证文件。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 来源默认 disabled、authorizationConfirmed=false；secretRef 保存环境变量名。
AISSTREAM_API_KEY=
MARINETRAFFIC_API_KEY=
# 来源授权和全球/区域 bbox 由 API 保存；海图使用本地深色底图。
# Windows 若只有 Bun 脚本 shim，可填写真正 bun.exe 的绝对路径。
BUN_EXECUTABLE=
# 专题进程按类型独立部署，空值时处理全部已注册类型。
TOPIC_DEFINITION_ID=
# 可选外部算法：JSON argv 数组，例如 ["python","/app/algorithm.py"]。
TOPIC_EXECUTOR_COMMAND=
# 本地文件情报适配器的显式根目录。
INTELLIGENCE_FILE_ROOT=
# 区域研判智能体：API 与 agent 进程共同启用；密钥仅注入 agent 进程。
AGENT_ENABLED=false
# 语义界面状态与命令回执；需同时启用 AGENT_ENABLED。
AGENT_UI_ENABLED=false
# 私有技能自主创建、发布与动态执行；API 和 Agent 必须同步配置。
AGENT_DYNAMIC_SKILLS_ENABLED=false
# 空间回复沿用 Agent 界面权限；业务写工具按明确指令和操作员权限执行。
AGENT_SPATIAL_FOCUS_ENABLED=true
AGENT_BUSINESS_WRITE_ENABLED=false
# 会话对象与条件继承、账号长期记忆；先应用数据库迁移，再启用相应能力。
AGENT_SESSION_MEMORY_ENABLED=true
AGENT_ACCOUNT_MEMORY_ENABLED=true
# 自动提取只生成待确认候选；正式生效由当前账号确认。
AGENT_MEMORY_PROPOSALS_ENABLED=true
# 迁移和规划数据导入完成后启用相应后台能力。
ROUTE_PLANNING_ENABLED=true
EVENT_SYNC_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 模型思考默认 high；off 关闭，仅影响模型请求，与工具循环预算独立。
AGENT_THINKING_LEVEL=high
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_RECORDS=50000
